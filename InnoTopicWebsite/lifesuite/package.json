{
  "name": "LifeSuite",
  "version": "0.0.1",
  "author": "npm install -g @ionic/cli@latest Framework",
  "homepage": "https://cloudtime.innotopic.com",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "postinstall": "node scripts/patch-node-modules.mjs",
    "prestart": "node scripts/write-build-info.mjs",
    "prestartWithAutoReload": "node scripts/write-build-info.mjs",
    "prebuild": "node scripts/write-build-info.mjs",
    "prebuild:prod": "node scripts/write-build-info.mjs",
    "ng": "pnpm exec ng",
    "start": "node scripts/build-copilotkit-react-embed.mjs && pnpm exec ng serve --port 4207",
    "startWithAutoReload": "node scripts/build-copilotkit-react-embed.mjs && pnpm exec ng serve --port 4207",
    "build": "node scripts/build-copilotkit-react-embed.mjs && pnpm exec ng build",
    "build:copilotkit-react": "node scripts/build-copilotkit-react-embed.mjs",
    "build:prod": "pnpm exec ionic build --prod --aot",
    "record:browser:install": "pnpm exec playwright-core install chromium ffmpeg",
    "record:browser": "node scripts/browser-recorder.mjs",
    "record:browser:local": "node scripts/browser-recorder.mjs --url http://localhost:4207 --headed",
    "test": "pnpm exec ng test",
    "test:e2e": "pnpm exec playwright test",
    "test:odm": "vitest run",
    "test:ai-backend": "jest --config scripts/jest.ai-backend.config.js --runTestsByPath scripts/test-ai-backend-mock.test.ts scripts/test-ai-backend-real.test.ts --runInBand",
    "test:ai-backend:mock": "jest --config scripts/jest.ai-backend.config.js --runTestsByPath scripts/test-ai-backend-mock.test.ts",
    "test:ai-backend:real": "jest --config scripts/jest.ai-backend.config.js --runTestsByPath scripts/test-ai-backend-real.test.ts",
    "android:sync": "pnpm exec cap sync android",
    "android:open": "pnpm exec cap open android",
    "android:run": "pnpm exec cap run android",
    "compodoc": "pnpm exec compodoc -p tsconfig.doc.json",
    "format": "pnpm exec prettier --write \"src/**/*.{ts,html,scss,sass,css,json}\"",
    "format:check": "pnpm exec prettier --check \"src/**/*.{ts,html,scss,sass,css,json}\""
  },
  "private": true,
