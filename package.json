{
  "name": "LifeSuite",
  "version": "0.0.1",
  "author": "npm install -g @ionic/cli@latest Framework",
  "homepage": "https://cloudtime.innotopic.com",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/build-copilotkit-react-embed.mjs && ng serve --port 4207 --live-reload false",
    "startWithAutoReload": "node scripts/build-copilotkit-react-embed.mjs && ng serve --port 4207",
    "build": "node scripts/build-copilotkit-react-embed.mjs && ng build",
    "build:copilotkit-react": "node scripts/build-copilotkit-react-embed.mjs",
    "build:prod": "npx ionic build --prod --aot",
    "record:browser:install": "npx playwright-core install chromium ffmpeg",
    "record:browser": "node scripts/browser-recorder.mjs",
    "record:browser:local": "node scripts/browser-recorder.mjs --url http://localhost:4207 --headed",
    "test": "ng test",
    "test:ai-backend": "jest --config scripts/jest.ai-backend.config.js --runTestsByPath scripts/test-ai-backend-mock.test.ts scripts/test-ai-backend-real.test.ts --runInBand",
    "test:ai-backend:mock": "jest --config scripts/jest.ai-backend.config.js --runTestsByPath scripts/test-ai-backend-mock.test.ts",
    "test:ai-backend:real": "jest --config scripts/jest.ai-backend.config.js --runTestsByPath scripts/test-ai-backend-real.test.ts",
    "debug.android": "ionic cordova run android  -l --debug --",
    "compodoc": "npx compodoc -p tsconfig.doc.json"
  },
