# LifeSuite TypeScript AI Backend — copy to .env and fill in values

PORT=8000

# Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Optional: Tavily web search API key
TAVILY_API_KEY=

# Optional: Neon/PostgreSQL for ODM endpoints
# ODM_DATABASE_URL=postgresql://user:pass@host/db
# ODM_ENSURE_TABLES=1
