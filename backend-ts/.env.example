# LifeSuite TypeScript AI Backend — copy to .env and fill in values

PORT=8000

# AI API (OpenAI-compatible — Sub2API, Ollama, OpenAI, etc.)
AI_API_BASE_URL=http://localhost:8080/v1
AI_API_KEY=sub2api
AI_MODEL=gpt-4o-mini

# Ollama (disabled — uncomment and remove AI_API_* above to use instead)
# AI_API_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=llama3.2

# Optional: Tavily web search API key
TAVILY_API_KEY=

# Optional: Neon/PostgreSQL for ODM endpoints
# ODM_DATABASE_URL=postgresql://user:pass@host/db
# ODM_ENSURE_TABLES=1
