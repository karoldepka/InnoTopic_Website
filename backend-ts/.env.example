# LifeSuite TypeScript AI Backend — copy to .env and fill in values

PORT=8000

# AI API (OpenAI-compatible — Sub2API, Ollama, OpenAI, etc.)
AI_API_BASE_URL=http://localhost:8080/v1
AI_API_KEY=sub2api
AI_MODEL=gpt-4o-mini

# Ollama (disabled — uncomment and remove AI_API_* above to use instead)
# AI_API_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=llama3.2

# Optional: Tavily web search API key
TAVILY_API_KEY=

# Server-side voice memo transcription (/ai-api/transcribe) - needs a *real* OpenAI key
# regardless of what AI_API_BASE_URL/AI_API_KEY above are set to (e.g. if those point at Ollama),
# since transcription models aren't served by most OpenAI-compatible proxies.
OPENAI_API_KEY=
# gpt-4o-transcribe (default) or whisper-1
TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Semantic search (/api/odm/search). Defaults to OpenAI's 1536-dimensional model.
# EMBEDDING_API_KEY falls back to OPENAI_API_KEY.
EMBEDDING_API_KEY=
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Optional: Neon/PostgreSQL for ODM endpoints
# ODM_DATABASE_URL=postgresql://user:pass@host/db
# ODM_ENSURE_TABLES=1
